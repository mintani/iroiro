{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "printWidth": 100,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css",
    "functions": ["cn"]
  },
  "ignorePatterns": [
    "node_modules",
    ".next",
    "dist",
    "build",
    ".open-next",
    ".wrangler"
  ]
}
