{
  "name": "iroiro",
  "version": "0.1.0",
  "private": true,
  "description": "Palette, theme tokens and exports from any image, entirely in the browser.",
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "oxlint src && oxfmt --check src",
    "check:fix": "oxlint --fix src && oxfmt --write src",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "dev": "next dev",
    "format": "oxfmt --check src",
    "format:fix": "oxfmt --write src",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "preview": "npm_execpath= npm_config_user_agent= alchemy dev",
    "start": "next start",
    "test": "vitest --run",
    "typecheck": "tsgo --noEmit",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.516.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.77",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.1",
    "alchemy": "2.0.0-beta.77",
    "effect": "4.0.0-rc.112",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/sql-d1": "4.0.0-rc.112",
    "@effect/sql-sqlite-do": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112"
  },
  "packageManager": "bun@1.3.13"
}
