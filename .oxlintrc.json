{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc", "import", "jsx-a11y", "nextjs", "react", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-explicit-any": "error",
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "import/no-unassigned-import": "off"
  },
  "settings": {
    "jsx-a11y": {
      "components": {
        "Button": "button",
        "Toggle": "button"
      }
    },
    "next": {
      "rootDir": ["."]
    }
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "node_modules",
    ".next",
    "dist",
    "build",
    ".open-next",
    ".wrangler",
    "*.config.js",
    "*.config.ts"
  ]
}
